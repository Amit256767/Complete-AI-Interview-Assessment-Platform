generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("CANDIDATE")
  createdAt    DateTime  @default(now())
  resumes      Resume[]
  attempts     Attempt[]
  dailyUsage   DailyUsage[]
  geminiUsage  GeminiApiUsage[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  text      String   @db.Text
  skills    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id          String   @id @default(cuid())
  prompt      String   @db.Text
  category    String
  difficulty  String
  type        String
  options     Json
  answerIndex Int
  explanation String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Attempt {
  id        String            @id @default(cuid())
  userId    String
  category  String
  role      String
  difficulty String
  status    String            @default("IN_PROGRESS")
  score     Int?
  evaluation Json?
  deadline  DateTime
  createdAt DateTime          @default(now())
  idempotencyKey String?
  dailyUsageId String?
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyUsage DailyUsage?      @relation(fields: [dailyUsageId], references: [id], onDelete: SetNull)
  questions AttemptQuestion[]
  responses Response[]
  geminiUsage GeminiApiUsage[]

  @@unique([userId, idempotencyKey])
  @@index([dailyUsageId])
  @@index([userId, status, createdAt])
}

model AttemptQuestion {
  id          String     @id @default(cuid())
  attemptId   String
  position    Int
  prompt      String     @db.Text
  type        String
  options     Json
  answerIndex Int
  explanation String     @db.Text
  attempt     Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  responses   Response[]

  @@unique([attemptId, position])
}

model Response {
  id         String          @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  correct    Boolean         @default(false)
  createdAt  DateTime        @default(now())
  attempt    Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   AttemptQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model DailyUsage {
  id                 String   @id @default(cuid())
  userId             String
  dayStart           DateTime @db.Date
  mockInterviewCount Int      @default(0)
  geminiRequestCount Int      @default(0)
  geminiInputTokens  Int      @default(0)
  geminiOutputTokens Int      @default(0)
  geminiTotalTokens  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts           Attempt[]
  geminiUsage        GeminiApiUsage[]

  @@unique([userId, dayStart])
  @@index([userId, dayStart])
}

model GeminiApiUsage {
  id             String   @id @default(cuid())
  userId         String
  attemptId      String
  dailyUsageId   String
  operation      String
  model          String
  statusCode     Int?
  succeeded      Boolean
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  dailyUsage     DailyUsage @relation(fields: [dailyUsageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([attemptId, operation])
  @@index([dailyUsageId, createdAt])
}

model GeminiDailyQuota {
  id          String   @id @default(cuid())
  dayStart    DateTime @db.Date @unique
  requestCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
